#!/usr/bin/env python3
# Stands in for agent-usage-claude and agent-usage-codex in the smoke tests
# (cinnamon/test/smoke-test.sh, test/gnome/smoke-test.sh):
# prints a record shaped like theirs, with numbers that fill every section of
# the panel. Claude has limits and a busy week; Codex is signed out, so its
# tab shows the problem card.

import datetime
import json
import os
import sys

agent = os.path.basename(sys.argv[0]).replace("agent-usage-", "")
now = datetime.datetime.now(datetime.timezone.utc)
today = datetime.date.today()


def at(**delta):
    return (now + datetime.timedelta(**delta)).isoformat()


def week(*counts):
    return [{"date": (today - datetime.timedelta(days=len(counts) - 1 - i)).isoformat(), "messageCount": n}
            for i, n in enumerate(counts)]


