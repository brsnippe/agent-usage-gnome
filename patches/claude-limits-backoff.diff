+def iso_from_ms(ms: int) -> str:
+  return dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc).isoformat()
+
+
+def rate_limited_note(until_seconds: float) -> str:
+  return "Anthropic is rate limiting checks · next try " + dt.datetime.fromtimestamp(until_seconds).strftime("%H:%M")
+
+
+# Cached limits shown in place of a fresh probe say so: when they were
+# measured, and why nothing newer is available. Without this the record's
+# updatedAt keeps moving while the percentages quietly stop.
+def use_cached(result: dict[str, Any], fallback: list[dict[str, Any]], cached: dict[str, Any], note: str) -> None:
+  result["limits"] = fallback
+  if not fallback:
+    return
+  result["limitsStale"] = True
+  fetched_ms = number(cached.get("fetchedAtMs"))
+  if fetched_ms > 0:
+    result["limitsFetchedAt"] = iso_from_ms(fetched_ms)
+  if note:
+    result["limitsNote"] = note
+
