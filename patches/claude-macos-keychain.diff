Not from upstream: on macOS, read Claude Code's login from the Keychain
("Claude Code-credentials", or its hashed name when CLAUDE_CONFIG_DIR is set)
as well as from .credentials.json, and use the login that lasts longest.
Applies on top of claude-limits-backoff.diff.

--- a/bin/omarchy-agent-usage-claude
+++ b/bin/omarchy-agent-usage-claude
@@ -22,9 +22,11 @@
 import os
 import re
 import sqlite3
+import subprocess
 import sys
 import tempfile
 import time
+import unicodedata
 import urllib.error
 import urllib.request
 from pathlib import Path
@@ -39,6 +41,11 @@
 # `retry-after: 0`, so the wait doubles on each refusal within these bounds.
 BACKOFF_MIN_SECONDS = 60
 BACKOFF_MAX_SECONDS = 900
+# On macOS, Claude Code keeps its login in the Keychain; .credentials.json only
+# shows up there when the Keychain refused the write. Elsewhere there is no
+# Keychain to ask.
+SECURITY_TOOL = "/usr/bin/security" if sys.platform == "darwin" else ""
+KEYCHAIN_SERVICE = "Claude Code-credentials"
 
 
 def config_dir() -> Path:
@@ -606,17 +613,78 @@
 # nowhere but the Authorization header of the limits probe, and only the
 # plan label may travel into the printed record.
 def oauth_login(claude_dir: Path) -> tuple[str, int, str]:
-  try:
-    data = json.loads((claude_dir / ".credentials.json").read_text(encoding="utf-8"))
-  except Exception:
-    return "", 0, ""
-  login = data.get("claudeAiOauth")
-  if not isinstance(login, dict):
+  logins = [login for login in [file_login(claude_dir)] + keychain_logins() if login is not None]
+  if not logins:
     return "", 0, ""
+  # A login that moved to a new Keychain name leaves the old entry behind,
+  # expired, so the one that lasts longest is the live one.
+  login = max(logins, key=lambda entry: number(entry.get("expiresAt")))
   plan = plan_label(str(login.get("rateLimitTier") or ""), str(login.get("subscriptionType") or ""))
   return str(login.get("accessToken") or ""), number(login.get("expiresAt")), plan
 
 
+def parse_login(text: str) -> dict[str, Any] | None:
+  try:
+    login = json.loads(text).get("claudeAiOauth")
+  except Exception:
+    return None
+  return login if isinstance(login, dict) else None
+
+
+def file_login(claude_dir: Path) -> dict[str, Any] | None:
+  try:
+    return parse_login((claude_dir / ".credentials.json").read_text(encoding="utf-8"))
+  except Exception:
+    return None
+
+
+# The Keychain entry is named the way the CLI names it: plain for the default
+# folder, and with "-" plus the first 8 hex digits of the folder's SHA-256 once
+# CLAUDE_CONFIG_DIR (or CLAUDE_SECURESTORAGE_CONFIG_DIR) is set. Some versions
+# used the hashed name for the default folder too, so both are tried there.
+def keychain_services() -> list[str]:
+  def hashed(folder: str) -> str:
+    digest = hashlib.sha256(unicodedata.normalize("NFC", folder).encode("utf-8")).hexdigest()
+    return KEYCHAIN_SERVICE + "-" + digest[:8]
+
+  storage = os.environ.get("CLAUDE_SECURESTORAGE_CONFIG_DIR")
+  if storage is not None:
+    return [hashed(storage)] if storage else [KEYCHAIN_SERVICE]
+  configured = os.environ.get("CLAUDE_CONFIG_DIR")
+  if configured:
+    return [hashed(configured)]
+  return [KEYCHAIN_SERVICE, hashed(str(Path.home() / ".claude"))]
+
+
+def keychain_logins() -> list[dict[str, Any]]:
+  if not SECURITY_TOOL:
+    return []
+  logins = []
+  for service in keychain_services():
+    try:
+      found = subprocess.run(
+        [SECURITY_TOOL, "find-generic-password", "-s", service, "-w"],
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        timeout=10,
+      )
+    except Exception:
+      continue
+    if found.returncode != 0:
+      continue
+    secret = found.stdout.decode("utf-8", errors="replace").strip()
+    # `security -w` prints a secret holding non-ASCII text as hex.
+    if re.fullmatch(r"(?:[0-9a-fA-F]{2})+", secret):
+      try:
+        secret = bytes.fromhex(secret).decode("utf-8")
+      except ValueError:
+        pass
+    login = parse_login(secret)
+    if login is not None:
+      logins.append(login)
+  return logins
+
+
 def plan_label(tier: str, subscription: str) -> str:
   if tier:
     match = re.search(r"max_(\d+x)", tier, re.IGNORECASE)
