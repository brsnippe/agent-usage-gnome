+def scan_opencode_v2_sessions():
+  # OpenCode v2 writes its messages to session_message (keyed to session_v2)
+  # in the same database; the classic message table never sees them, so a
+  # subscription burned through v2 on an OpenAI provider is invisible without
+  # this scan. Same trailing-month window, same exact provider match.
+  # Returns whether the scan ran to completion, like the classic scan.
+  db = opencode_db_path()
+  if not db.is_file():
+    return True
+  try:
+    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
+  except sqlite3.Error:
+    return False
+  try:
+    conn.execute("PRAGMA query_only = ON")
+    # Machines whose opencode predates v2 have no session_message table:
+    # nothing to read is a complete scan, not an interrupted one, or the
+    # zero snapshot would disable caching until opencode upgrades.
+    if not conn.execute(
+      "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'session_message'"
+    ).fetchone():
+      return True
+    cutoff_ms = int((time.time() - SCAN_WINDOW_SECONDS) * 1000)
+    for session_id, raw in conn.execute(
+      "SELECT session_id, data FROM session_message"
+      " WHERE time_created >= ?"
+      " AND type = 'assistant'"
+      " AND data LIKE '%\"providerID\"%:%\"openai\"%'"
+      " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.model.providerID') END = 'openai'",
+      (cutoff_ms,),
+    ):
+      # One malformed row must not abort the scan, so every shape assumption
+      # lives inside the try.
+      try:
+        entry = json.loads(raw)
+        if not isinstance(entry, dict):
